# Copy to .env (git-ignored) — used by `docker compose up`. Never commit real values.
# Required (generate SECRET_KEY: python -c "import secrets;print(secrets.token_urlsafe(50))"):
SECRET_KEY=
GROQ_API_KEY=

# Google sign-in (optional). Create an OAuth 2.0 Web client in the Google Cloud
# console, add your site to its authorised JavaScript origins, and paste the
# client ID here. It is a public identifier, not a secret. Left empty,
# /auth/google answers 503 and the rest of the app works normally.
# GOOGLE_CLIENT_ID=

# Optional overrides (defaults suit local Docker):
# DAILY_QUERY_QUOTA=100
# MAX_UPLOAD_MB=25
# RAG_AGENTIC_MODE=true
