# ── Django ────────────────────────────────────────────────────────────────────
# Generate a real key with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# ── MySQL (AWS RDS) ───────────────────────────────────────────────────────────
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=3306
DB_NAME=your-db-name
DB_USER=your-db-user
DB_PASSWORD=your-db-password

# ── Qdrant Cloud ──────────────────────────────────────────────────────────────
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=documents

# ── AWS ───────────────────────────────────────────────────────────────────────
# Leave blank in production — attach an IAM role to your EC2/ECS instead
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=your-s3-bucket-name
TRANSCRIBE_OUTPUT_BUCKET=your-s3-bucket-name

# ── RAG Agent ─────────────────────────────────────────────────────────────────
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
RAG_TOP_K=5
