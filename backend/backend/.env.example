# Reference for every setting the app reads. Copy to backend/backend/.env for non-Docker
# development. Real values belong in the host's secret store, never in git.

# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# SECURE_SSL_REDIRECT=True            # only applies when DEBUG=False

# ── Database ──────────────────────────────────────────────────────────────────
# Managed Postgres, e.g. Neon/Supabase. Leave unset for a local SQLite file.
DATABASE_URL=

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=documents

# ── Object storage (STORAGE_BACKEND=local stores under backend/local_storage) ─
STORAGE_BACKEND=local                 # local | s3
OBJECT_STORAGE_BUCKET=arishem-documents
OBJECT_STORAGE_ENDPOINT_URL=          # blank for AWS S3; set for R2 / MinIO
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_REGION=us-east-1

# ── Celery / cache ────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CACHE_URL=                            # redis://localhost:6379/2 shares rate limits across workers

# ── RAG ───────────────────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL_ID=llama-3.3-70b-versatile
RAG_TOP_K=5
RAG_CONFIDENCE_THRESHOLD=0.35
RAG_AGENTIC_MODE=true
SELF_CRITIQUE_ENABLED=true

# ── Signup, limits and cost controls ──────────────────────────────────────────
MAX_QUESTION_CHARS=1000
MAX_TOP_K=10
MAX_UPLOAD_MB=25
DAILY_QUERY_QUOTA=100                 # per user per day; admins exempt
THROTTLE_RATE_VIEWER=10/min
THROTTLE_RATE_EDITOR=60/min
THROTTLE_RATE_ADMIN=100/min
THROTTLE_RATE_AUTH=20/min             # per IP on register/login
MAX_INGESTION_QUEUE_DEPTH=50

# ── OAuth (optional; endpoints stay disabled when blank) ──────────────────────
google_client_id=
GITHUB_CLIENT_ID=
GITHUB_SECRET=

# ── Optional features (default off) ───────────────────────────────────────────
ENABLE_MEETINGS=False                 # needs requirements-optional.txt + ffmpeg
ENABLE_SOCIAL_AUTH=False
